{
  "name": "overwatch-monorepo",
  "version": "1.0.0",
  "description": "Overwatch — NSE trading assistant. Monorepo: core doctrine library + CLI (+ server/worker/web).",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @overwatch/core && npm run build -w @overwatch/cli",
    "start": "npm run start -w @overwatch/cli",
    "seed": "node scripts/seed.mjs",
    "test": "node runtime/daemons/test-monitor-runtime.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.80.2",
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "@mariozechner/pi-agent-core": "^0.73.1"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^26.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
